{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "ios-simulator": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    },
    "ios-device": {
      "distribution": "internal",
      "environment": "preview",
      "credentialsSource": "remote",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
