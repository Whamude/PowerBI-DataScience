{
  "expo": {
    "name": "Nutria",
    "slug": "Nutria",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/nutria-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nutria.mobile",
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#235A43",
        "foregroundImage": "./assets/nutria-foreground.png"
      },
      "package": "app.nutria.mobile",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/nutria-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"]
          }
        }
      ]
    ],
    "scheme": "nutria",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3fcedfe1-f754-4191-be79-eb7350492f26"
      }
    },
    "owner": "whamudes-team"
  }
}
