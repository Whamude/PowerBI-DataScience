# Copy the values into the service manager's environment (this file is NOT auto-loaded).
# A separate deployment, SQLite database and set of credentials is needed per business/number.
DATABASE_PATH=data/marmita.sqlite3
BUSINESS_TIMEZONE=America/Sao_Paulo

# Generate independent random secrets, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Only OWNER_API_TOKEN and the public HTTPS service URL go into the Android app.
OWNER_API_TOKEN=
WEBHOOK_VERIFY_TOKEN=

# Meta developer app and WhatsApp Business Platform credentials. Never put these in the APK.
META_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Choose a supported Graph API version configured for the Meta app, e.g. v27.0 if available there.
# Required, not automatically upgraded. Example is illustrative, not a promise of account availability.
META_GRAPH_VERSION=

# An effective human escalation route, e.g. a separate business telephone.
# Do not promise a human will respond through the WhatsApp API unless an operator actually monitors it.
HUMAN_CONTACT_TEXT=

# False by default: never sends real messages until the operator explicitly enables production sends.
WHATSAPP_SEND_ENABLED=false
